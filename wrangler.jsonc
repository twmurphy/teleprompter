{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teleprompter",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-26",
  "observability": { "enabled": true },
  // Keep the workers.dev URL during development: it is the only place the API
  // can be tested with no Access in front, which is how the deny path is checked.
  "workers_dev": true,
  "routes": [{ "pattern": "teleprompter.twm-sandbox.com", "custom_domain": true }],
  // Neither is secret: the AUD is a public application identifier and the team
  // domain hosts the public signing keys. They pin token checks to this app.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "twm-sandbox.cloudflareaccess.com",
    "ACCESS_AUD": "416ffe0d63d7e2228a37e168a0fe1b1d862ea82853efcd76237234a1d70916b0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teleprompter",
      "database_id": "9b52124f-6793-44f6-91cb-32e0fe230613",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The app is one page; anything that is not a real file is still the app.
    "not_found_handling": "single-page-application",
    // API routes must reach the Worker rather than falling through to index.html.
    "run_worker_first": ["/api/*"]
  }
}
